# Copy to .env.local. Values for local development come from `npm run db:start` (supabase status).

# Public: inlined into the browser bundle.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5174
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: read through src/shared/config/env.server.ts.
SUPABASE_SECRET_KEY=

# At least 32 random characters; signs media upload receipts and rate-limit keys.
MEDIA_SIGNING_SECRET=

# At least 32 random characters; bearer authentication for internal jobs.
JOB_SECRET=
