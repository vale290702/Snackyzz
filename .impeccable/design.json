  "narrative": {
    "northStar": "The Confectionery Campaign",
    "overview": "Snackyzz feels like a confident food campaign translated into a practical store. Oversized editorial type, honest cookie photography, warm paper surfaces, and a sharp orange accent make the product desirable without slowing down cart, checkout, or order review.\n\nDense operational screens reduce the display scale while retaining the same palette, typography, and tactile controls. The system stays warm, direct, and legible across phone, tablet, and desktop.",
    "keyCharacteristics": [
      "Cream canvas with chocolate structure and decisive orange actions.",
      "Rounded editorial display type paired with quiet sans-serif controls.",
      "Large product photography and compact, factual supporting copy.",
      "Flat tonal layering; shadows appear only for temporary floating feedback."
    ],
    "rules": [
      {
        "name": "The Orange Has a Job Rule",
        "body": "Use orange for appetite, action, or brand cadence; never scatter it as decoration.",
        "section": "colors"
      },
      {
        "name": "The Tint-and-Ink Rule",
        "body": "A status color appears as text on a 15% tint of itself, never as white text on a solid fill. Each pairing keeps 4.5:1 on both paper and cream.",
        "section": "colors"
      },
      {
        "name": "The Three-to-One Outline Rule",
        "body": "A control whose outline is its only cue (an unchecked checkbox or radio) takes Muted Brown. Warm Line (1.57:1 on paper) only outlines fields that already carry a visible label.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Fraunces speaks for products and moments; DM Sans handles every instruction and operation.",
        "section": "typography"
      },
      {
        "name": "The No Sideways Scroll Rule",
        "body": "Horizontal overflow is never acceptable on the page. Wide tables scroll inside their own container instead.",
        "section": "layout"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Prefer a change in warm surface tone before adding a border or shadow.",
        "section": "elevation"
      },
      {
        "name": "The Only Toasts Float Rule",
        "body": "If it isn't temporary feedback that leaves on its own, it doesn't get a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep checkout status language precise: received, pending review, confirmed.",
      "Do give cookie photography enough scale to carry appetite and recognition.",
      "Do preserve the four committed brand colors throughout new screens.",
      "Do stack operational layouts intentionally on small screens.",
      "Do pair every status tint with its own ink color (honey on honey, leaf on leaf, warm red on warm red).",
      "Do give every field a visible label; the warm-line outline relies on it."
    ],
    "donts": [
      "Don't introduce cool grays, blue SaaS accents, glass effects, or generic dashboard gradients.",
      "Don't invent product, ingredient, payment, or location claims.",
      "Don't hide order totals, confirmation state, or recovery actions inside decorative UI.",
      "Don't replace the display/body type relationship with a single system font.",
      "Don't put shadows on cards, dialogs, sheets, or menus; only toasts float.",
      "Don't dim overlays with black; use chocolate."
    ]
  }
}
